{
  "name": "mengzhang-hp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:vercel": "cross-env NODE_ENV=development NEXT_PUBLIC_DEPLOY_DOMAIN=\"http://localhost:3000/\" DEPLOY_MODE=\"private\" VERCEL_DEV=\"true\" vercel dev",
